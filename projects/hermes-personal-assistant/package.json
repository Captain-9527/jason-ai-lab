{
  "name": "hermes-personal-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "setup": "node scripts/setup.mjs",
    "smoke": "node --env-file-if-exists=.env dist/smoke.js",
    "login": "node --env-file-if-exists=.env dist/login.js",
    "browser:install": "node --env-file-if-exists=.env node_modules/playwright/cli.js install chromium",
    "service:start": "node scripts/service.mjs start",
    "service:stop": "node scripts/service.mjs stop",
    "service:status": "node scripts/service.mjs status",
    "call": "node --env-file-if-exists=.env dist/call.js",
    "config:hermes": "node scripts/hermes-config.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/client": "2.4.0",
    "playwright": "1.64.1",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.20.5",
    "@types/better-sqlite3": "7.6.13"
  }
}
